{
    "manifest_version": 3,
    "name": "Grammar and Tone Adjuster",
    "version": "1.0",
    "description": "Correct grammar and change the tone of selected text using Gemini API",
    "permissions": ["activeTab", "storage"],
    "host_permissions": ["https://generativelanguage.googleapis.com/*"],
    "action": {
      "default_popup": "popup.html"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["styles.css"]
      }
    ],
    "background": {
      "service_worker": "background.js",
      "type": "module"
    }
  }